#!/bin/bash
#SBATCH --partition=compute
#SBATCH --account=mh0033
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --constraint=256G
#SBATCH --mem=0
#SBATCH --time=01:00:00
#SBATCH --output=workOutput/expID/LOG.expID_%j.log
#SBATCH --error=workOutput/expID/LOG.expID_%j.log
#SBATCH --mail-user=jdoe@mail.com
#SBATCH --mail-type=END
#SBATCH --job-name=expID

module load r/4.4.2-gcc-11.2.0

set -eE  # same as: `set -o errexit -o errtrace`
trap 'cleanup' ERR

# best effort: a failing step here must not stop the ones after it, the status
# is written first so it is right whatever else fails. With errexit off the
# script would carry on after the handler, so the handler ends it.
function cleanup(){
  set +e
  trap - ERR
  echo failed > workOutput/expID/status
  echo "FAILED! Cleaning up..."
  Rscript --max-connections=1024 -e "source('initialise.R'); source('config.R'); source('cleanup.R')"
  mkdir -p workOutput/expID/runScriptsAndConfiguration
  mv expID_*.R workOutput/expID/runScriptsAndConfiguration/
  mv expID.run workOutput/expID/runScriptsAndConfiguration/
  exit 1
}

echo started > workOutput/expID/status
Rscript --max-connections=1024 -e "source('runMLEandParmSpace.R'); source('runDetermineRepresentativeSamples.R'); source('runPlotAllRuns.R'); source('cleanup.R')"
echo completed > workOutput/expID/status

mkdir -p workOutput/expID/runScriptsAndConfiguration
mv expID_*.R workOutput/expID/runScriptsAndConfiguration/
mv expID.run workOutput/expID/runScriptsAndConfiguration/

